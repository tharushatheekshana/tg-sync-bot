# Get API_ID and API_HASH from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Optional: Telethon StringSession for the user account.
# If left empty, the script will prompt for your phone number & login code on first run
# and save a local 'user_session.session' file.
STRING_SESSION=

# Bot Owner Telegram User ID(s) who can add/remove Paid users via /addpaid and /removepaid
OWNER_IDS=

# Paid VIP Telegram User IDs (can use WhatsApp Sync/Upload & multiple Telegram Syncs).
# Managed automatically from Telegram via /addpaid, /removepaid, or inline approval buttons.
ADMIN_IDS=

# Public Mode: when true (default), anyone can use the bot on the Free Plan
# (downloads, streaming, channel joins, /tg upload, and 1 Telegram Auto-Sync rule).
# Only Paid VIP users (in ADMIN_IDS) and Owners can use WhatsApp Sync/Upload and multiple TG Syncs.
PUBLIC_MODE=true
FREE_MAX_TG_SYNC_RULES=1

# Optional but recommended: @username for VIP upgrade, billing, and refund support (/paysupport)
OWNER_CONTACT=

# Delay (in seconds) between joining multiple channels in bulk
JOIN_DELAY_SECONDS=3


# ---------------------------------------------------------------------------
# WhatsApp upload (/wa) — uses the local Node.js sidecar in wa_sidecar/
# ---------------------------------------------------------------------------
# Default WhatsApp group JID used by /wa (set it from Telegram with /wagroup)
WA_GROUP_ID=
# Start the sidecar automatically together with bot.py
WA_SIDECAR_AUTOSTART=true
WA_SIDECAR_HOST=127.0.0.1
WA_SIDECAR_PORT=3100
# Optional shared secret between bot.py and the sidecar
WA_API_TOKEN=
# Delay (seconds) between WhatsApp uploads to avoid spam detection
WA_SEND_DELAY_SECONDS=3
# Media size limits (MB); larger files are sent as documents
WA_VIDEO_MAX_MB=100
WA_IMAGE_MAX_MB=16
WA_AUDIO_MAX_MB=16
# Absolute WhatsApp file limit (MB); larger files are skipped
WA_MAX_FILE_MB=2000

# ---------------------------------------------------------------------------
# Auto-Sync Telegram Channels to WhatsApp (/sync)
# ---------------------------------------------------------------------------
# Default text and caption settings when adding new sync channels
WA_SYNC_SEND_TEXT=true
WA_SYNC_SEND_CAPTIONS=true

# ---------------------------------------------------------------------------
# Telegram Channel Upload (/tg) & Telegram-to-Telegram Auto-Sync (/tgsync)
# ---------------------------------------------------------------------------
# Default destination Telegram channel/group ID or @username (set via /tgchannel)
TG_UPLOAD_CHANNEL_ID=
# Delay (seconds) between consecutive Telegram channel uploads
TG_SEND_DELAY_SECONDS=2
# Include text-only messages and media captions when uploading with /tg
TG_SEND_TEXT=true
TG_SEND_CAPTIONS=true
# Default text and caption settings when adding new Telegram auto-sync channels
TG_SYNC_SEND_TEXT=true
TG_SYNC_SEND_CAPTIONS=true
